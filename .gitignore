# General / root-level ignores (monorepo-wide)

# ---- Python ----
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / extensions (if applicable) ----
node_modules/
dist/
build/
*.tsbuildinfo

# ---- Packaging (PyInstaller) ----
*.spec

# ---- Virtualization / tooling ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
.vagrant/
.cache/

# ---- Logs & temp ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets / local env ----
.env
.env.*
!.env.example
*.pem
*.key
