# attlytics agent configuration
# Copy this file to `.env` and adjust as needed. Values are read at import
# time by agent/config.py.

# Where the local activity-event SQLite database lives.
DB_PATH=agent/data/activity_events.db

# How often (seconds) the active application is polled for state changes.
POLL_INTERVAL_SECONDS=1.0

# How often (seconds) a HEARTBEAT is recorded while a state stays active.
HEARTBEAT_INTERVAL_SECONDS=60.0

# Seconds without user input before the user is considered idle.
IDLE_THRESHOLD_SECONDS=120.0
