# --- App ---
ENVIRONMENT=development
APP_NAME=Attlytics API
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/attlytics

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Optional, defaults to 30.
# SESSIONIZE_INTERVAL_SECONDS=30

# --- API ---
API_V1_PREFIX=/api/v1

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=20
REFRESH_TOKEN_EXPIRE_DAYS=7
